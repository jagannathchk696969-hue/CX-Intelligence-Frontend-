{
  "name": "cx-intelligence-monorepo",
  "version": "1.0.0",
  "description": "CX Intelligence - AI-Powered Customer Experience Management Platform",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "test": "npm --prefix backend test",
    "seed": "npm --prefix backend run seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "customer-experience",
    "ai",
    "sentiment-analysis",
    "chatbot",
    "tickets",
    "analytics"
  ],
  "author": "Antigravity Engineering",
  "license": "MIT"
}
